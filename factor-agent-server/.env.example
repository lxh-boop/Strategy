# ===== 智谱开放平台 =====
# API Key / 团队 Token（必填）：登录 https://open.bigmodel.cn -> 控制台 -> API Keys
ZHIPU_API_KEY=
# 对话模型：GLM-5.3-Flash；如报"模型不存在"，以智谱控制台文档里的 model ID 为准
ZHIPU_MODEL=glm-5.3-flash
# 推理模型思考开关：disabled（默认，快且稳）/ enabled（开深度思考，慢但可能更聪明）
ZHIPU_THINKING=disabled

# ===== GLM 调用协调（并发治理 C1，团队套餐共享 key 形态下自收并发）=====
# 在飞调用上限（超出排队等待）
GLM_MAX_CONCURRENCY=2
# 429 限流退避重试次数上限（退避 1s/2s/4s/8s/8s…封顶 8s）
GLM_RETRY_MAX=10
# 退避基数毫秒（测试可调小）
GLM_BACKOFF_BASE_MS=1000
# 智谱 API 地址：团队 Token（编码套餐）必须走 /api/coding/paas/v4，
#   普通充值 API Key 走 /api/paas/v4（套餐模型在标准端点会报 403/429 余额不足）
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4

# ===== 服务 =====
PORT=3000
# 单次请求上游的超时时间（毫秒）
CHAT_TIMEOUT_MS=60000
# 系统提示词（可选，不填用内置的选股智能体人设）
SYSTEM_PROMPT=

# ===== MySQL 因子数据库 =====
# 公司 herms_data 库（TB 级只读，查询务必带剪枝）：智能体因子取数（FactorDataService）用
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
# 密码含 # 等特殊字符时必须加英文双引号（dotenv 会把 # 后内容当注释截断）
MYSQL_PASSWORD=
MYSQL_DATABASE=herms_data
# 连接池大小
MYSQL_CONNECTION_LIMIT=5

# ===== 用户库（M13，可写）=====
# 团队共享 MySQL（当前 192.168.0.30，向队友要连接信息），存账号/策略/会话/设置；
# 不配 HOST 则服务用内存存储兜底（重启丢数据，仅本地联调）
USER_DB_HOST=
USER_DB_PORT=3306
USER_DB_USER=
USER_DB_PASSWORD=
USER_DB_DATABASE=alphasage_user
USER_DB_CONNECTION_LIMIT=5

# ===== 登录鉴权 JWT（M13）=====
# 留空用内置开发密钥；建议统一配一个随机值（node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
# 登录 token 签名密钥：各机器各填一串随机字符即可；不填则用内置开发密钥（仅开发环境用）
USER_JWT_SECRET=
USER_JWT_EXPIRES=7d

# ===== 长期记忆与历史滚动窗口（ADR-0007，prompt 分支修订）=====
# 记忆根目录：<目录>/<userId>/<slug>.md 条目 + <userId>/_threads/<会话id>.md 摘要缓存；
# 缺省 <运行目录>/memories（已 gitignore）。以下数值全是旋钮，缺省即用可不动
MEMORIES_DIR=
# 记忆摘要目标字数上限（队头折叠产物）
MEMORY_SUMMARY_CHARS=500
# 记忆队列 token 预算（estTokens 估算：中文≈1/字、ASCII≈1/4），
# 超过即把队头最老的若干条折叠进记忆摘要（追加制不判重，频次=追加即保活）
MEMORY_QUEUE_MAX_TOKENS=2000
# 历史段 token 预算（estTokens 估算：中文≈1/字、ASCII≈1/4），超过即折叠压缩：
# 保留最近 HISTORY_KEEP_TURNS 轮原文，更早轮次折叠进摘要轮（与正常对话同构的一问一答）
HISTORY_MAX_TOKENS=3000
# 压缩时保留的最近原文问答轮数
HISTORY_KEEP_TURNS=2
